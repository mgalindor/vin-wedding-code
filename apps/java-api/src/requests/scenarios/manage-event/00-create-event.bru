meta {
  name: Scenarios — create event (Maya & Luis)
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

script:pre-request {
  bru.setVar("scenarioEventTitle", "Boda Maya & Luis " + Date.now());
}

body:json {
  {
    "title": "{{scenarioEventTitle}} (Scenario)",
    "eventType": "wedding",
    "eventDate": "2027-09-12"
  }
}

vars:post-response {
  eventId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.status: eq "draft"
}

docs {
  Captures the event id as {{eventId}} for the entire scenario. Runs after
  auth/00-login.bru so {{organizerToken}} is in scope. Title includes a per-run
  timestamp (scenarioEventTitle) so 14-list-my-events.bru's title filter stays
  deterministic even though the dev DB accumulates events across reruns.
}
