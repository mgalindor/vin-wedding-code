meta {
  name: Scenarios — create event (Maya & Luis)
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "title": "Boda Maya & Luis (Scenario)",
    "eventType": "wedding",
    "eventDate": "2027-09-12"
  }
}

vars:post-response {
  eventId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.status: eq "draft"
}

docs {
  Captures the event id as {{eventId}} for the entire scenario. Runs after
  auth/00-login.bru so {{organizerToken}} is in scope.
}
