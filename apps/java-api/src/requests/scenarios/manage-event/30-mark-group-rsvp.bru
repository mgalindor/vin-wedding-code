meta {
  name: Scenarios — admin marks whole group confirmed
  type: http
  seq: 31
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups/{{groupId}}/rsvp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "status": "confirmed",
    "message": "Called them all — everyone's in"
  }
}

assert {
  res.status: eq 200
}
