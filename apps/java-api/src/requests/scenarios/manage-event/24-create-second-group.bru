meta {
  name: Scenarios — create second group for the change-group test
  type: http
  seq: 25
}

post {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "name": "Amigos del Trabajo",
    "relationship": "friends",
    "guests": [
      { "fullName": "Pedro López", "primary": true }
    ]
  }
}

vars:post-response {
  secondGroupId: res.body.id
  secondGroupPrimaryId: res.body.primaryGuestId
}

assert {
  res.status: eq 201
}
