meta {
  name: Scenarios — list invitation templates
  type: http
  seq: 19
}

get {
  url: {{host}}/api/v1/invitation-templates?eventType=wedding&onlyActive=true
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

vars:post-response {
  templateId: res.body.items[0].id
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.items[0].id: isString
}
