meta {
  name: Scenarios — non-admin tries to read someone else (expect 404)
  type: http
  seq: 10
}

get {
  url: {{host}}/api/v1/users/{{robertoId}}
  auth: bearer
}

auth:bearer {
  token: {{miguelToken}}
}

assert {
  res.status: eq 403
}

docs {
  Same authorization rule as editing: non-admins may only read themselves.
  UserController's @PreAuthorize ("hasRole('Administrator') or #id == authentication.name")
  rejects at the security layer with 403 before the controller/service logic runs, so there
  is no existence-masking to 404 here (unlike some other resource-ownership checks in this API).
}
