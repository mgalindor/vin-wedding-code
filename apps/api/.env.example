# Wendy Planner API — local dev template (ARC-013 + ARC-015).
# Copy to `.env.local` in the monorepo root and fill in the placeholders.
# `.env.local` is gitignored; this `.env.example` is committed for reference.
#
# NOTE: in OPS-023 we moved to a two-layer env design: the committed
# `<monorepo>/.env` carries the non-sensitive defaults (NODE_ENV,
# PORT, LOG_LEVEL, DATABASE_URL). `.env.local` overrides with
# sensitive values. The JWT_* fields below are sensitive and belong
# in `.env.local`, not `.env`. They are listed here for reference.

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# ─── Database (ADR-16, ARC-008) ──────────────────────────────────────────
DATABASE_URL=postgresql://wendy:wendy@localhost:5432/wendy?schema=public

# ─── JWT (ADR-05, ARC-013) ────────────────────────────────────────────────
# Generate the local RS256 key pair once:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Then paste the *contents* of jwt-private.pem between the quotes
# below (including the BEGIN/END lines).
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"
JWT_KEY_ID=00000000-0000-4000-8000-000000000000
JWT_ISSUER=wendy-planner
JWT_AUDIENCE=wendy
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
