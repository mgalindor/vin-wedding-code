meta {
  name: Scenarios — set contacts payload
  type: http
  seq: 6
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/contacts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "entries": [
      {
        "label": "Wedding Planner",
        "fullName": "Ana Rodriguez",
        "phone": "+52 55 1234 5678",
        "email": "ana@example.com"
      },
      {
        "label": "Photographer",
        "fullName": "Carlos Mendez",
        "phone": "+52 55 8765 4321",
        "email": "carlos@example.com"
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.contacts.entries.length: eq 2
}
