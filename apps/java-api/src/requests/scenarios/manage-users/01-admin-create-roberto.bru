meta {
  name: Scenarios — admin creates roberto (non-admin target for negative tests)
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

script:pre-request {
  bru.setVar("robertoSlug", "roberto" + Date.now());
}

body:json {
  {
    "username": "{{robertoSlug}}",
    "displayName": "Roberto Pérez",
    "email": "roberto@example.com",
    "password": "RobertoPass1!",
    "roles": ["EventOrganizer"]
  }
}

vars:post-response {
  robertoId: res.body.id
  robertoUsername: res.body.username
}

assert {
  res.status: eq 201
  res.body.username: eq "{{robertoSlug}}@deer"
}
