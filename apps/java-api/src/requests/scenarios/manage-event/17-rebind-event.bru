meta {
  name: Scenarios — rebind eventId for guest operations
  type: http
  seq: 18
}

script:pre-request {
  // vars:pre-request template interpolation ({{guestEventId}}) was found to not reliably
  // resolve here — use bru.setVar explicitly instead.
  bru.setVar("eventId", bru.getVar("guestEventId"));
}

get {
  url: {{host}}/api/v1/events/{{eventId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{guestEventId}}
}

docs {
  Trivial GET — its job is to re-establish {{eventId}} as the guest-phase event
  for every request that follows (those use {{eventId}} from the parent folder
  convention rather than the new {{guestEventId}}).
}
