# Node / pnpm
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
# - `.env` is committed: it holds NON-SENSITIVE defaults (DB host, TTLs,
#   issuer/audience). The PEM private key NEVER lives here.
# - `.env.local` and `.env.*.local` are gitignored: per-developer overrides
#   (private keys, real credentials, etc.). See `apps/api/.env` header.
.env.local
.env.*.local

# Defence-in-depth: even if someone accidentally adds a secret to a
# file outside the .env pattern, never let it leak.
*.pem
*.key
apps/api/jwt-dev/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
.DS_Store

# Test / coverage
coverage/
.nyc_output/

# NestJS
.nest/

# Prisma
apps/api/prisma/migrations/dev/

# Tooling caches
.eslintcache
.cache/
.turbo/
