meta {
  name: Public — reject guest not in group
  type: http
  seq: 48
}

put {
  url: {{host}}/api/v1/public/invitations/{{slug}}/groups/{{groupToken}}/rsvp
  body: json
}

body:json {
  {
    "guests": [
      { "guestId": "gst-not-in-this-group", "status": "confirmed" }
    ]
  }
}

assert {
  res.status: eq 422
  res.body.code: eq "guest_not_in_group"
}

docs {
  Validation: every guestId in the body must belong to the group identified by
  groupToken. No partial writes happen if any guestId is invalid.
}