meta {
  name: Events — delete (cleanup)
  type: http
  seq: 9
}

delete {
  url: {{host}}/api/v1/events/{{eventId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

assert {
  res.status: eq 204
}

docs {
  Cleanup so the collection is rerunnable. The soft-delete flag marks the row as
  deleted; the underlying row stays for audit but is invisible to subsequent reads.
}