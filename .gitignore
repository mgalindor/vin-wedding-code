# Node / pnpm
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
# - `.env` is committed: it holds non-sensitive defaults that externalize
#   config out of source code. See `code/.env` for the header comment.
# - `.env.local` and `.env.*.local` are gitignored: they hold per-developer
#   overrides (private keys, real credentials, etc.).
.env.local
.env.*.local

