meta {
  name: Scenarios — create guest group with two inline guests (primary required)
  type: http
  seq: 21
}

post {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "name": "Familia García (Scenario)",
    "relationship": "family",
    "sharedEmail": "garcia-family@example.com",
    "sharedPhone": "+521112223334",
    "displayOrder": 0,
    "guests": [
      { "firstName": "Juan", "lastName": "García", "primary": true },
      { "firstName": "María", "lastName": "García" }
    ]
  }
}

vars:post-response {
  groupId: res.body.id
  groupToken: res.body.invitationToken
  primaryGuestId: res.body.primaryGuestId
  guestId1: res.body.guests[0].id
  guestId2: res.body.guests[1].id
}

assert {
  res.status: eq 201
  res.body.primaryGuestId: isString
  res.body.invitationToken: isString
  res.body.guests.length: eq 2
}

tests {
  test("primary guest is the first inline guest", function() {
    expect(res.getBody().primaryGuestId).to.equal(res.getBody().guests[0].id);
  });
}
