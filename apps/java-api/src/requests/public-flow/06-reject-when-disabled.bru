meta {
  name: Public — submit while RSVP disabled (must fail)
  type: http
  seq: 50
}

put {
  url: {{host}}/api/v1/public/invitations/{{slug}}/groups/{{groupToken}}/rsvp
  body: json
}

body:json {
  {
    "guests": [
      { "guestId": "{{guestId1}}", "status": "confirmed" }
    ]
  }
}

assert {
  res.status: eq 422
  res.body.code: eq "rsvp_disabled"
}