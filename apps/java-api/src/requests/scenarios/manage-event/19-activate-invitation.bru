meta {
  name: Scenarios — activate invitation config
  type: http
  seq: 20
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/invitation-config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

script:pre-request {
  // Use a run-unique slug: event_invitation_config rows aren't cascade-deleted when their
  // parent event is soft-deleted, so a fixed slug collides with "slug_taken" (422) on any
  // rerun against a persistent dev DB once a prior run has used it.
  bru.setVar("invitationSlug", "guest-regression-" + Date.now());
}

body:json {
  {
    "templateId": "{{templateId}}",
    "slug": "{{invitationSlug}}",
    "active": true,
    "rsvpEnabled": true,
    "deadline": "2027-10-15",
    "rsvpDeadline": "2027-11-01"
  }
}

vars:post-response {
  slug: res.body.slug
}

assert {
  res.status: eq 200
  res.body.active: eq true
  res.body.slug: eq "{{invitationSlug}}"
}
