meta {
  name: Guest groups — regenerate token
  type: http
  seq: 29
}

post {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups/{{groupId}}/regenerate-token
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

vars:post-response {
  groupToken: res.body.invitationToken
}

assert {
  res.status: eq 200
  res.body.invitationToken: isString
}

docs {
  Issues a fresh UUID for invitationToken, invalidating the previous one. Any
  RSVP link the organizer shared before this call stops working.
}