meta {
  name: Scenarios — confirm the deleted guest is gone from the group
  type: http
  seq: 35
}

get {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups/{{groupId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("guestId1 is no longer in the group", function() {
    const guests = res.getBody().guests;
    const ids = guests.map(g => g.id);
    expect(ids).to.not.include(bru.getVar("guestId1"));
  });
}

assert {
  res.status: eq 200
}
