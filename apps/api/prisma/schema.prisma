// Prisma schema — Wendy Planner (ADR-11, ADR-13, ADR-07).
// Source of truth for all tables. Sprint 1 ships exactly the `users` model.
// Each bounded context adds its own model in its own migration
// (evolutionary design rule).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenants (US-001). One row per tenant — the slug email suffix is
// read from this table, not from env (no TENANT_EMAIL_SUFFIX env var).
// Sprint 1 ships exactly one row, seeded by tools/db-seed.ts.
model tenants {
  id String @id

  email_suffix String @unique(map: "idx_tenants_email_suffix")
  display_name String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("tenants")
}

// Identity & Access (ARC-008). tenant_id is a column from day one but no
// tenants table exists yet (ADR-07); application code filters by it.
model users {
  id String @id

  tenant_id String

  email     String  @unique(map: "idx_users_email")
  full_name String
  phone     String?

  // bcrypt cost 12 (ADR-05). 72 chars is bcrypt's truncation limit.
  password_hash String

  role UserRole

  // Nullable FK to users.id — no FK constraint in Sprint 1 (no tenants table).
  // ARC-011 will convert this to a proper FK in Sprint 2.
  onboarded_by_admin_id String?

  is_disabled Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([tenant_id], name: "idx_users_tenant_id")
  @@map("users")
}

enum UserRole {
  Administrator
  WeddingPlanner
}

// Wedding Management (US-009 / ARC-019).
// Source of truth for the weddings table; US-009 ships the create flow
// against this model. `wedding_data` (per-template payload) is owned by
// ARC-020 / US-022 and is intentionally NOT created here — per the
// project's lean principle (do not add tables until strictly necessary).
model weddings {
  id String @id

  tenant_id     String
  // FK to users.id (no DB-level constraint; the relationship is enforced
  // at the application layer, mirroring the existing users.onboarded_by_admin_id
  // pattern until ARC-011 lands).
  owner_user_id String

  partner_1_name String
  partner_2_name String
  event_date     DateTime @db.Date
  // Ceremony start time (HH:mm:ss, venue-local — second precision is
  // overkill for an MVP but matches Postgres `time` natively).
  // Nullable for rows that existed before the field was added and for
  // create flows that omit it. The wire DTO trims the `:ss` suffix.
  start_time     DateTime? @db.Time

  venue_name String
  venue_city String

  status WeddingStatus @default(draft)

  created_at         DateTime @default(now())
  created_by_user_id String
  updated_at         DateTime @updatedAt
  updated_by_user_id String

  // US-014a: list of event locations (ceremony, reception, etc.).
  // Stored as a JSONB array of typed WeddingLocationDto objects —
  // the wire shape is a typed array, never a stringified JSON blob.
  // The column is NOT NULL with a JSON default so every existing row
  // is backfilled to an empty array in the migration transaction; the
  // mapper validates the parsed JSON through `WeddingLocationDto`
  // (class-validator) before returning it to the controller.
  locations Json @default("[]")

  @@index([tenant_id, owner_user_id, status], name: "idx_weddings_tenant_owner_status")
  @@index([tenant_id, owner_user_id, event_date], name: "idx_weddings_tenant_owner_date")
  @@map("weddings")
}

enum WeddingStatus {
  draft
  published
  archived
}
