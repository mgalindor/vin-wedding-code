meta {
  name: Invitation config — re-enable RSVP
  type: http
  seq: 24
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/invitation-config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "templateId": "{{templateId}}",
    "slug": "{{slug}}",
    "active": true,
    "rsvpEnabled": true,
    "deadline": "2027-03-15",
    "rsvpDeadline": "2027-04-01"
  }
}

assert {
  res.status: eq 200
  res.body.rsvpEnabled: eq true
}