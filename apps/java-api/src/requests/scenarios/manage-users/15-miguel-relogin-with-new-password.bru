meta {
  name: Scenarios — miguel re-logins with the admin-reset password
  type: http
  seq: 16
}

post {
  url: {{host}}/oauth/token
  body: json
}

body:json {
  {
    "grantType": "password",
    "username": "{{miguelUsername}}",
    "password": "AdminResetPass1!"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}
