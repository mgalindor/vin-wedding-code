meta {
  name: Scenarios — admin lists users
  type: http
  seq: 3
}

get {
  url: {{host}}/api/v1/users?size=500
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("list includes the two scenario users", function() {
    const items = res.getBody().items;
    const usernames = items.map(u => u.username);
    expect(usernames).to.include(bru.getVar("miguelUsername"));
    expect(usernames).to.include(bru.getVar("robertoUsername"));
    expect(usernames).to.include("admin@deer");
  });
}

assert {
  res.status: eq 200
  res.body.items: isArray
}

docs {
  Sorted createdAt DESC by default, so admin@deer (the oldest user, seeded at first boot)
  falls off the default 20-row page as more test users accumulate across reruns of this
  scenario. size=500 keeps this deterministic without needing per-user filtered lookups.
}
