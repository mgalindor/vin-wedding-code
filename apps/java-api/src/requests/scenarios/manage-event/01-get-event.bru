meta {
  name: Scenarios — get event
  type: http
  seq: 2
}

get {
  url: {{host}}/api/v1/events/{{eventId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{eventId}}
  res.body.title: eq "Boda Maya & Luis (Scenario)"
  res.body.status: eq "draft"
}
