meta {
  name: Scenarios — list groups for the event
  type: http
  seq: 22
}

get {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("the scenario group is in the list", function() {
    const groups = res.getBody().items;
    expect(groups.find(g => g.id === bru.getVar("groupId"))).to.exist;
  });
}

assert {
  res.status: eq 200
  res.body.items: isArray
}
