meta {
  name: Events — create
  type: http
  seq: 4
}

post {
  url: {{host}}/api/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "title": "Boda Maya & Luis",
    "eventType": "wedding",
    "eventDate": "2027-04-15"
  }
}

vars:post-response {
  eventId: res.body.id
}

assert {
  res.status: eq 201
  res.body.id: isString
  res.body.title: eq "Boda Maya & Luis"
  res.body.eventType: eq "wedding"
  res.body.status: eq "draft"
}

docs {
  Creates the event in draft status and captures its id as {{eventId}}.
}