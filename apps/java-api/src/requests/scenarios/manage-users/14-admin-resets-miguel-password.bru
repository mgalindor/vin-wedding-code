meta {
  name: Scenarios — admin resets miguel's password
  type: http
  seq: 15
}

patch {
  url: {{host}}/api/v1/users/{{miguelId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "password": "AdminResetPass1!"
  }
}

assert {
  res.status: eq 200
}
