meta {
  name: Scenarios — update event metadata
  type: http
  seq: 3
}

patch {
  url: {{host}}/api/v1/events/{{eventId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "title": "{{scenarioEventTitle}} — Final",
    "eventDate": "2027-09-19"
  }
}

assert {
  res.status: eq 200
  res.body.title: eq "{{scenarioEventTitle}} — Final"
  res.body.eventDate: eq "2027-09-19"
}
