meta {
  name: Admin RSVP — reset to pending
  type: http
  seq: 43
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/guests/{{guestId2}}/rsvp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "status": "pending"
  }
}

assert {
  res.status: eq 200
  res.body.rsvpStatus: eq "pending"
  res.body.rsvpConfirmedAt: eq null
}

docs {
  Resetting to pending clears rsvpConfirmedAt. Use this when an organizer
  undoes a previous confirmation.
}