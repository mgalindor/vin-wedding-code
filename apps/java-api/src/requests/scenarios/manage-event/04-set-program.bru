meta {
  name: Scenarios — set program payload
  type: http
  seq: 5
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/program
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "days": [
      {
        "date": "2027-09-19",
        "label": "Boda",
        "items": [
          { "time": "16:00", "title": "Ceremony" },
          { "time": "17:00", "title": "Cocktail" },
          { "time": "19:00", "title": "Reception" }
        ]
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.program.days[0].items.length: eq 3
}
