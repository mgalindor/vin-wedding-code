meta {
  name: Wedding — landing
  type: http
  seq: 15
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/wedding-landing
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "preTitle": "You are cordially invited"
  }
}

assert {
  res.status: eq 200
  res.body.landing.preTitle: eq "You are cordially invited"
}