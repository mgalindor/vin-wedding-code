# apps/api/.env - committed defaults (NON-SENSITIVE ONLY).
#
# Private keys, secrets, and per-developer overrides live in
# 'apps/api/.env.local' (gitignored). Copy this file to '.env.local'
# and fill in JWT_PRIVATE_KEY_PEM generated by 'pnpm gen:keys'.
#
# Example:
#   pnpm gen:keys          # generates ephemeral RS256 keypair
#   cp .env .env.local    # only needed first time
#   pnpm start:dev

# --- Database (local docker-compose defaults - non-sensitive) ---
DATABASE_URL='postgresql://wendy:wendy@localhost:5432/wendy?schema=public'

# --- JWT ---
# Private key (RS256). Loaded from .env.local in dev. The key id and
# issuer/audience below are public metadata, safe to commit.
JWT_KEY_ID='dev-1'
JWT_ISSUER='wendy-planner'
JWT_AUDIENCE='wendy'

# Token TTLs (seconds) - see tech-spec.md section Token Lifecycle.
# Access: 1 hour. Refresh: 3 days. No revocation in MVP.
JWT_ACCESS_TOKEN_TTL_SECONDS='3600'
JWT_REFRESH_TOKEN_TTL_SECONDS='259200'

# --- Server ---
NODE_ENV='development'
PORT='3000'
