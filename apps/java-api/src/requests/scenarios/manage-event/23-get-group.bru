meta {
  name: Scenarios — get the scenario group
  type: http
  seq: 24
}

get {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups/{{groupId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{groupId}}
  res.body.invitationToken: eq {{groupToken}}
  res.body.primaryGuestId: eq {{primaryGuestId}}
}
