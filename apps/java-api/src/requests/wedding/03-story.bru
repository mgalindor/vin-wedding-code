meta {
  name: Wedding — story
  type: http
  seq: 16
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/wedding-story
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "body": "We met in college eight years ago..."
  }
}

assert {
  res.status: eq 200
  res.body.story.body: isString
}