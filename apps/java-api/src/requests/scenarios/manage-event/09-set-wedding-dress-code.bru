meta {
  name: Scenarios — set wedding dress-code
  type: http
  seq: 10
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/wedding-dress-code
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "entries": [
      { "title": "Black tie", "body": "Optional for the reception" },
      { "title": "Garden attire", "body": "Comfortable shoes for the lawn ceremony" }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.dressCode.entries.length: eq 2
}
