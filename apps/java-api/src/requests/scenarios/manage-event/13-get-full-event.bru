meta {
  name: Scenarios — get full event (verify every payload)
  type: http
  seq: 14
}

get {
  url: {{host}}/api/v1/events/{{eventId}}
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

tests {
  test("base event payloads populated by the previous steps are present", function() {
    const b = res.getBody();
    expect(b.locations.entries).to.have.length(2);
    expect(b.program.days[0].items).to.have.length(3);
    expect(b.contacts.entries).to.have.length(2);
  });
}

assert {
  res.status: eq 200
  res.body.locations.entries.length: eq 2
  res.body.program.days[0].items.length: eq 3
  res.body.contacts.entries.length: eq 2
}

docs {
  EventDto intentionally excludes type-specific data (wedding detail, landing, story, etc.) —
  see EventDto's javadoc. Those fields live behind the dedicated
  GET /events/{eventId}/wedding-detail endpoint (and its sibling section endpoints), not here.
}
