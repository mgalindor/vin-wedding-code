meta {
  name: Public — submit partial attendance
  type: http
  seq: 47
}

put {
  url: {{host}}/api/v1/public/invitations/{{slug}}/groups/{{groupToken}}/rsvp
  body: json
}

body:json {
  {
    "message": "Solo podemos ir algunos",
    "guests": [
      { "guestId": "{{guestId1}}", "status": "confirmed" },
      { "guestId": "{{guestId2}}", "status": "declined" }
    ]
  }
}

assert {
  res.status: eq 200
}