meta {
  name: Admin RSVP — single guest declined
  type: http
  seq: 42
}

put {
  url: {{host}}/api/v1/events/{{eventId}}/guests/{{guestId2}}/rsvp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "status": "declined",
    "message": "Cannot attend — out of country"
  }
}

assert {
  res.status: eq 200
  res.body.rsvpStatus: eq "declined"
}