meta {
  name: Scenarios — create guest group with two inline guests (primary required)
  type: http
  seq: 21
}

post {
  url: {{host}}/api/v1/events/{{eventId}}/guest-groups
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "name": "Familia García (Scenario)",
    "relationship": "family",
    "sharedEmail": "garcia-family@example.com",
    "sharedPhone": "+521112223334",
    "displayOrder": 0,
    "guests": [
      { "fullName": "Juan García", "primary": true },
      { "fullName": "María García" }
    ]
  }
}

vars:post-response {
  groupId: res.body.id
  groupToken: res.body.invitationToken
  primaryGuestId: res.body.primaryGuestId
}

assert {
  res.status: eq 201
  res.body.primaryGuestId: isString
  res.body.invitationToken: isString
}

docs {
  GuestGroupDto does NOT embed the inline-created guests in this response (no
  `guests` field) — only primaryGuestId/invitationToken. The next request
  (21-list-family-group-guests) fetches the guest list to capture guestId1/guestId2.
}
