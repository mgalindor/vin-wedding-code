meta {
  name: Users — update self (owner changes displayName)
  type: http
  seq: 4
}

patch {
  url: {{host}}/api/v1/users/{{createdUserId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{organizerToken}}
}

body:json {
  {
    "displayName": "Dana Self-Edited"
  }
}

assert {
  res.status: eq 200
  res.body.displayName: eq "Dana Self-Edited"
}

docs {
  Owner self-edit. Roles sent here are ignored (the service checks the actor and only
  honours `roles` from an Administrator).
}
